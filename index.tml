            <div style="color: #854d0e; font-size: 12px; font-weight:800;">Accuracy</div>
            <div class="res-val" style="color: #854d0e;" id="rAcc">0%</div>
          </div>
          <div class="res-card" style="border-color: #f472b6; background: rgba(219, 39, 119, 0.12);">
            <div style="color: #be185d; font-size: 12px; font-weight:800;">Net Score</div>
            <div class="res-val" style="color: #be185d;" id="rScore">0.00</div>
          </div>
        </div>

        <div class="analytics-visual-box">
          <div class="pie-chart-wrap" id="pieChartVisual">
            <div class="pie-inner-circle">
              <span id="pieAccuracyLabel" style="font-size: 16px; color: #be185d;">0%</span>
              <span style="font-size: 10px; color: var(--text-muted); font-weight: 800;">ACCURACY</span>
            </div>
          </div>

          <div class="bar-graph-wrap">
            <div class="bar-row">
              <div style="display:flex; justify-content:space-between;">
                <span>🟢 Correct Answers</span>
                <span id="labelBarCorrect">0</span>
              </div>
              <div class="bar-track"><div class="bar-fill-correct" id="barFillCorrect"></div></div>
            </div>
            <div class="bar-row">
              <div style="display:flex; justify-content:space-between;">
                <span>🔴 Wrong Answers</span>
                <span id="labelBarWrong">0</span>
              </div>
              <div class="bar-track"><div class="bar-fill-wrong" id="barFillWrong"></div></div>
            </div>
            <div class="bar-row">
              <div style="display:flex; justify-content:space-between;">
                <span>⚪ Skipped / Left</span>
                <span id="labelBarSkipped">0</span>
              </div>
              <div class="bar-track"><div class="bar-fill-skipped" id="barFillSkipped"></div></div>
            </div>
          </div>
