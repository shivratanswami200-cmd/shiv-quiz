        <div class="q-body">
          <div class="prompt-text" id="qPrompt"></div>
          <div id="qOptions"></div>

          <div class="inline-explanation-box" id="inlineExpBox">
            <div style="font-weight: 800; color: #be185d; margin-bottom: 4px;">💡 विस्तृत व्याख्या:</div>
            <div id="inlineExpContent"></div>
          </div>
        </div>

        <div class="q-footer" id="examFooterNormal">
          <div>
            <button class="btn-act" onclick="markForReviewAndNext()">Mark for Review</button>
            <button class="btn-act" onclick="clearResponse()">Clear Response</button>
          </div>
          <div>
            <button class="btn-save" onclick="saveAndNext()">Save & Next</button>
            <button class="btn-submit" onclick="finalizeSubmission()">Submit Test</button>
          </div>
        </div>

        <div class="q-footer" id="examFooterReview" style="display:none;">
          <div>
            <button class="btn-act" onclick="navigateReview(-1)">⬅️ Previous</button>
            <button class="btn-act" onclick="navigateReview(1)">Next ➡️</button>
          </div>
          <button class="btn-submit" onclick="goToStage(7)">📊 Scorecard</button>
        </div>
      </div>

      <!-- Right Dock Palette -->
      <div class="palette-dock" id="paletteDock">
        <div class="user-tag">
          <img id="userPhotoExam" class="palette-avatar-circle" src="[https://i.pinimg.com/736x/b0/b8/81/b0b881f13789d87f5339564b0d5aed3e.jpg](https://i.pinimg.com/736x/b0/b8/81/b0b881f13789d87f5339564b0d5aed3e.jpg)" alt="SHIV" onerror="this.onerror=null; this.src='[https://i.pinimg.com/736x/b0/b8/81/b0b881f13789d87f5339564b0d5aed3e.jpg](https://i.pinimg.com/736x/b0/b8/81/b0b881f13789d87f5339564b0d5aed3e.jpg)';">
          <div>
            <b style="font-size: 14px;">COMMANDER SHIV</b><br>
            <span style="font-size: 11px; color: var(--text-muted); font-weight:700;">Status: Online</span>
          </div>
        </div>

        <div class="legend-table" id="legendTableWrap">
          <div style="display:flex; align-items:center; gap:6px;">
            <div class="shape-ans" id="badgeAns">0</div> <span>Ans</span>
          </div>
          <div style="display:flex; align-items:center; gap:6px;">
            <div class="shape-notans" id="badgeNotAns">0</div> <span>Not Ans</span>
          </div>
          <div style="display:flex; align-items:center; gap:6px;">
            <div class="shape-notvisit" id="badgeNotVisit">0</div> <span>Not Visit</span>
          </div>
          <div style="display:flex; align-items:center; gap:6px;">
            <div class="shape-review" id="badgeRev">0</div> <span>Marked</span>
          </div>
          <div style="display:flex; align-items:center; gap:6px; grid-column: span 2;">
            <div class="shape-ans-review" id="badgeAnsRev">0</div> <span>Answered & Marked</span>
          </div>
