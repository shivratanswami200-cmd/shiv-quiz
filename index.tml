  </div>

  <!-- STAGE 7: Result Analytics Card with Fireworks & Chart -->
  <div class="view-screen" id="viewStage7">
    <div style="padding: 14px; flex: 1; overflow-y: auto;">
      <div class="result-sheet">
        <div class="congrats-title">🎉 Congratulations COMMANDER SHIV!</div>
        <div style="font-size: 14px; color: var(--text-muted); font-weight:700;">आपने सफलतापूर्वक परीक्षा पूरी कर ली है! यहाँ आपका विस्तृत स्कोरकार्ड है:</div>

        <div class="res-grid">
          <div class="res-card">
