        <div style="display:flex; justify-content:center; gap:12px; margin-top:18px; flex-wrap:wrap;">
          <button class="action-btn" onclick="startExamReviewMode()">📑 Review Solutions & Explanations</button>
          <button class="btn-back" onclick="goToStage(1)">🔄 Main Screen</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function initTheme() {
      const savedTheme = localStorage.getItem('portal_theme') || 'light';
      if (savedTheme === 'dark') {
        document.body.classList.add('dark-mode');
        document.getElementById('themeBtnText').innerText = '☀️ Light Mode';
      } else {
        document.body.classList.remove('dark-mode');
        document.getElementById('themeBtnText').innerText = '🌙 Dark Mode';
      }
    }

    function toggleColorTheme() {
      document.body.classList.toggle('dark-mode');
      const isDark = document.body.classList.contains('dark-mode');
      localStorage.setItem('portal_theme', isDark ? 'dark' : 'light');
      document.getElementById('themeBtnText').innerText = isDark ? '☀️ Light Mode' : '🌙 Dark Mode';
    }

    function goToStage(stageNum) {
      document.querySelectorAll('.view-screen').forEach(el => el.classList.remove('active-view'));
      document.getElementById(`viewStage${stageNum}`).classList.add('active-view');
      window.scrollTo(0, 0);
    }

    function toggleMobilePalette() {
      document.getElementById('paletteDock').classList.toggle('drawer-open');
      document.getElementById('paletteBackdrop').classList.toggle('drawer-open');
    }

    const divisibilityRulesData = [
      { num: 1, rule: "सभी पूर्णांक 1 से पूर्णतः विभाज्य होते हैं।", eg: "45 ÷ 1 = 45" },
      { num: 2, rule: "अंतिम इकाई अंक सम (Even: 0, 2, 4, 6, 8) होना चाहिए।", eg: "358 (अंतिम अंक 8)" },
      { num: 3, rule: "सभी अंकों का योग 3 से विभाज्य होना चाहिए।", eg: "4 + 7 + 1 = 12 (3 से विभाज्य)" },
      { num: 4, rule: "संख्या के अंतिम दो अंक 4 से कटने चाहिए या '00' हों।", eg: "15324 (24 ÷ 4 = 6)" },
      { num: 5, rule: "अंतिम अंक केवल 0 या 5 होना चाहिए।", eg: "845, 920" },
      { num: 6, rule: "संख्या 2 और 3 दोनों के नियमों का पालन करती हो।", eg: "372 (सम अंक और योग 12)" },
      { num: 7, rule: "अंतिम अंक को 2 गुना करके शेष संख्या में से घटाएं, परिणाम 7 से कटे।", eg: "343 ➔ 34 - (3×2) = 28" },
      { num: 8, rule: "अंतिम 3 अंक 8 से कटने चाहिए या '000' हों।", eg: "4832 (832 ÷ 8 = 104)" },
      { num: 9, rule: "संख्या के सभी अंकों का योग 9 से विभाज्य होना चाहिए।", eg: "729 ➔ 7+2+9 = 18" },
      { num: 10, rule: "संख्या का अंतिम इकाई अंक अनिवार्य रूप से 0 हो।", eg: "450, 1020" },
      { num: 11, rule: "विषम और सम स्थानों के अंकों के योग का अंतर 0 या 11 का गुणज हो।", eg: "1331 ➔ (1+3) - (3+1) = 0" },
      { num: 12, rule: "संख्या 3 और 4 दोनों से पूर्णतः विभाज्य होनी चाहिए।", eg: "144 (योग 9 और अंतिम दो अंक 44)" },
      { num: 13, rule: "अंतिम अंक को 4 से गुणा करके शेष संख्या में जोड़ें, परिणाम 13 से कटे।", eg: "169 ➔ 16 + (9×4) = 52" },
      { num: 14, rule: "संख्या सम हो (2 से कटे) और 7 से भी विभाज्य हो।", eg: "196 (सम है और 196 ÷ 7 = 28)" },
      { num: 15, rule: "संख्या 3 और 5 दोनों से पूर्णतः विभाज्य होनी चाहिए।", eg: "225" },
      { num: 16, rule: "संख्या के अंतिम 4 अंक 16 से पूर्णतः कटने चाहिए।", eg: "32512 (2512 ÷ 16 = 157)" },
      { num: 17, rule: "अंतिम अंक को 5 गुना करके शेष संख्या से घटाएं, अंतर 17 से कटे।", eg: "221 ➔ 22 - (1×5) = 17" },
      { num: 18, rule: "संख्या सम हो (2 से कटे) और अंकों का योग 9 से कटे।", eg: "324 (सम और योग 9)" },
      { num: 19, rule: "अंतिम अंक को 2 से गुणा करके शेष संख्या में जोड़ें, परिणाम 19 से कटे।", eg: "361 ➔ 36 + (1×2) = 38" },
      { num: 20, rule: "अंतिम दो अंक 00, 20, 40, 60, या 80 होने चाहिए।", eg: "480, 1260" }
    ];

    const fractionsData = [
      { f: "1/1", p: "100%" },
      { f: "1/2", p: "50%" },
      { f: "1/3", p: "33.33% (33 1/3%)" },
      { f: "1/4", p: "25%" },
      { f: "1/5", p: "20%" },
      { f: "1/6", p: "16.66% (16 2/3%)" },
      { f: "1/7", p: "14.28% (14 2/7%)" },
      { f: "1/8", p: "12.5% (12 1/2%)" },
      { f: "1/9", p: "11.11% (11 1/9%)" },
      { f: "1/10", p: "10%" },
      { f: "1/11", p: "9.09% (9 1/11%)" },
      { f: "1/12", p: "8.33% (8 1/3%)" },
      { f: "1/13", p: "7.69% (7 9/13%)" },
      { f: "1/14", p: "7.14% (7 1/7%)" },
      { f: "1/15", p: "6.66% (6 2/3%)" },
      { f: "1/16", p: "6.25% (6 1/4%)" },
      { f: "1/17", p: "5.88% (5 15/17%)" },
      { f: "1/18", p: "5.55% (5 5/9%)" },
      { f: "1/19", p: "5.26% (5 5/19%)" },
      { f: "1/20", p: "5%" },
      { f: "1/24", p: "4.16% (4 1/6%)" },
      { f: "1/25", p: "4%" },
      { f: "3/8", p: "37.5%" },
      { f: "5/8", p: "62.5%" },
      { f: "7/8", p: "87.5%" },
      { f: "4/7", p: "57.14%" },
      { f: "5/6", p: "83.33%" }
    ];

    function buildMathVault() {
      // Tables
      const tblBox = document.getElementById('tablesContainer');
      tblBox.innerHTML = '';
      for (let t = 21; t <= 30; t++) {
        let card = document.createElement('div');
        card.className = 'table-box';
        let html = `<h3>Table of ${t}</h3>`;
        for (let m = 1; m <= 10; m++) html += `<div>${t} × ${m} = <b>${t * m}</b></div>`;
        card.innerHTML = html;
        tblBox.appendChild(card);
      }

      // Cubes
      const cubeBox = document.getElementById('cubesContainer');
      cubeBox.innerHTML = '';
      for (let c = 11; c <= 25; c++) {
        let card = document.createElement('div');
        card.className = 'cube-box';
        card.innerHTML = `<b>${c}³</b><span>= ${c * c * c}</span>`;
        cubeBox.appendChild(card);
      }

      // Squares
      const sqBox = document.getElementById('squaresContainer');
      sqBox.innerHTML = '';
      for (let s = 1; s <= 100; s++) {
        let card = document.createElement('div');
        card.className = 'square-box';
        card.innerHTML = `<div>${s}²</div><b>= ${s * s}</b>`;
        sqBox.appendChild(card);
      }

      // Rules
      const ruleBox = document.getElementById('rulesContainer');
      ruleBox.innerHTML = '';
      divisibilityRulesData.forEach(item => {
        let card = document.createElement('div');
        card.className = 'rule-card';
        card.innerHTML = `
          <div class="rule-num">Rule for ${item.num}</div>
          <div class="rule-desc">${item.rule}</div>
          <div class="rule-eg">${item.eg}</div>
        `;
        ruleBox.appendChild(card);
      });

      // Fractions
      const fracBox = document.getElementById('fractionsContainer');
      fracBox.innerHTML = '';
      fractionsData.forEach(item => {
        let card = document.createElement('div');
        card.className = 'frac-card';
        card.innerHTML = `<b>${item.f}</b><span>= ${item.p}</span>`;
        fracBox.appendChild(card);
      });
    }

    // Predefined Practice Tests (PDF Replacement with Interactive Exam Mode)
    const practiceSetMath = [
      { q: "What will come in place of question mark (?)\n45% of 600 + ?% of 480 = 390", options: ["20", "25", "30", "15", "None of these"], ans: 1, exp: "45% of 600 = 270\n390 - 270 = 120\n(?/100)*480 = 120 => ? = (120*100)/480 = 25" },
      { q: "Find the wrong number in the following number series:\n12, 14, 32, 102, 414, 2090", options: ["14", "32", "102", "414", "None of these"], ans: 1, exp: "12*1 + 2 = 14\n14*2 + 3 = 31 (Not 32)\n31*3 + 4 = 97... Hence 32 is wrong." },
      { q: "Direction: Solve the quadratic equations:\nI. x² - 17x + 72 = 0\nII. y² - 19y + 90 = 0", options: ["x > y", "x < y", "x ≥ y", "x ≤ y", "x = y or relation cannot be established"], ans: 4, exp: "x = +9, +8\ny = +10, +9\nComparing: 9 < 10, 9 = 9, 8 < 10, 8 < 9 => x ≤ y (Ans: 3 if x≤y). Here x=y or no relation holds if overlapping. So Option D: x ≤ y." },
      { q: "Simplify:\n√784 + 18 × 15 - ? = 145", options: ["143", "153", "163", "173", "None of these"], ans: 1, exp: "28 + 270 - ? = 145 => 298 - ? = 145 => ? = 153" },
      { q: "What should come in place of question mark (?):\n8, 11, 20, 47, ?, 371", options: ["128", "138", "118", "126", "None of these"], ans: 0, exp: "Differences: +3, +9, +27, +81, +243 (Powers of 3)\n47 + 81 = 128" }
    ];

    const practiceSetReasoning = [
      { q: "Statements: P > Q ≥ R = S < T ≤ U\nConclusions:\nI. P > S\nII. R < U", options: ["Only conclusion I is true", "Only conclusion II is true", "Either conclusion I or II is true", "Neither conclusion I nor II is true", "Both conclusions I and II are true"], ans: 4, exp: "I. Path from P to S: P > Q ≥ R = S => P > S (True)\nII. Path from R to U: R = S < T ≤ U => R < U (True)\nBoth are true." },
      { q: "Statements: All Cups are Plates. Some Plates are Glasses. No Glass is a Bowl.\nConclusions:\nI. Some Cups are Glasses.\nII. No Bowl is a Plate.", options: ["Only conclusion I follows", "Only conclusion II follows", "Either I or II follows", "Neither I nor II follows", "Both I and II follow"], ans: 3, exp: "There is no direct link between Cup and Glass (False).\nBowl is only restricted with Glass, not Plate (False). Neither follows." },
      { q: "If all the vowels in the word 'BANKING' are replaced with their immediate next letter and consonants with previous letter, how many letters appear more than once?", options: ["None", "One", "Two", "Three", "More than three"], ans: 1, exp: "Original: B A N K I N G\nB(-1)=A, A(+1)=B, N(-1)=M, K(-1)=J, I(+1)=J, N(-1)=M, G(-1)=F\nNew: A, B, M, J, J, M, F => 'J' and 'M' appear twice (Two letters)." }
    ];

    function loadPredefinedTest(type) {
      if (type === 1) quizData = practiceSetMath;
      else quizData = practiceSetReasoning;

      document.getElementById('jsonPayload').value = JSON.stringify(quizData, null, 2);
      startLiveExam();
    }

    function openPromptModal() { document.getElementById('promptModal').style.display = 'flex'; }
    function closePromptModal(e) { document.getElementById('promptModal').style.display = 'none'; }
    function copyPromptToClipboard() {
      const text = document.getElementById('masterPromptText').innerText;
      navigator.clipboard.writeText(text).then(() => {
        alert("प्रॉम्प्ट कॉपी हो गया! अब AI में पेस्ट करके अपनी PDF से JSON बनाएं।");
        closePromptModal();
      });
    }

    let selectedMinutes = 20;
    function setTimeManual(mins, btn) {
      document.querySelectorAll('.time-chip').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      selectedMinutes = mins;
      document.getElementById('customMinutesInput').value = '';
    }
    function setTimeCustom(val) {
      if (val && val > 0) {
        document.querySelectorAll('.time-chip').forEach(b => b.classList.remove('active'));
        selectedMinutes = parseInt(val);
      }
    }

    // Exam Engine with Question-Specific Timer Tracking
    let quizData = [];
    let curQ = 0;
    let examStatuses = [];
    let userSelections = {};
    let questionTimesSpent = []; // Records exact time spent per question
    let testTimeRemaining = 20 * 60;
    let singleQTime = 0;
    let examTimerRef = null;
    let autoNextTimeout = null;
    let isReviewMode = false;

    function startLiveExam() {
      try {
        let parsed = JSON.parse(document.getElementById('jsonPayload').value);
        if (!Array.isArray(parsed) || parsed.length === 0) throw new Error();
        quizData = parsed;
      } catch(e) {
        alert("JSON फॉर्मेट अमान्य है! कृपया सही कोड पेस्ट करें।");
        return;
      }

      isReviewMode = false;
      document.getElementById('examTopTitle').innerText = "IBPS RRB Sectional Test 2027";
      document.getElementById('autoToggleContainer').style.display = "flex";
      document.getElementById('qTimerWrap').style.display = "inline";
      document.getElementById('examFooterNormal').style.display = "flex";
      document.getElementById('examFooterReview').style.display = "none";
      document.getElementById('legendTableWrap').style.display = "grid";

      testTimeRemaining = selectedMinutes * 60;
      examStatuses = new Array(quizData.length).fill(0);
      examStatuses[0] = 1;
      userSelections = {};
      questionTimesSpent = new Array(quizData.length).fill(0);

      goToStage(6);
      buildPaletteNodes();
      loadQuestionIndex(0);
      runExamClock();
    }

    function buildPaletteNodes() {
      const p = document.getElementById('paletteNodes');
      p.innerHTML = '';
      for (let i = 0; i < quizData.length; i++) {
        let n = document.createElement('div');
        n.className = 'p-node not-visited';
        n.id = `pnode-${i}`;
        n.innerText = i + 1;
        n.onclick = () => {
          jumpToQ(i);
          if (window.innerWidth <= 768) toggleMobilePalette();
        };
        p.appendChild(n);
      }
      if (!isReviewMode) refreshLegendCounts();
    }

    function loadQuestionIndex(idx) {
      // Accumulate time on previous question
      if (!isReviewMode && quizData.length > 0) {
        questionTimesSpent[curQ] = (questionTimesSpent[curQ] || 0) + singleQTime;
      }

      curQ = idx;
      singleQTime = 0;
      clearTimeout(autoNextTimeout);

      if (!isReviewMode && examStatuses[curQ] === 0) {
        examStatuses[curQ] = 1;
      }

      document.getElementById('labelQNum').innerText = `Question ${curQ + 1} / ${quizData.length}`;
      document.getElementById('qPrompt').innerText = quizData[curQ].q;

      const opts = document.getElementById('qOptions');
      opts.innerHTML = '';

      const expBox = document.getElementById('inlineExpBox');
      const expContent = document.getElementById('inlineExpContent');
      const letters = ['A', 'B', 'C', 'D', 'E'];

      if (!isReviewMode) {
        expBox.style.display = 'none';
        quizData[curQ].options.forEach((val, i) => {
          let row = document.createElement('label');
          row.className = 'opt-row';
          let checked = userSelections[curQ] === i;
          row.innerHTML = `<input type="radio" name="opt_rad" value="${i}" ${checked ? 'checked' : ''} onchange="pickOption(${i})">
                           <span><b>(${letters[i]})</b> ${val}</span>`;
          opts.appendChild(row);
        });
        syncPaletteStyles();
      } else {
        // Show exact time spent on this question in review
        let qSec = questionTimesSpent[curQ] || 0;
        let qm = Math.floor(qSec / 60).toString().padStart(2, '0');
        let qs = (qSec % 60).toString().padStart(2, '0');
        document.getElementById('masterTimer').innerText = `Time Spent: ${qm} : ${qs}`;
        document.getElementById('masterTimer').style.color = "#0284c7";
        document.getElementById('qStopwatch').innerText = `${qm} : ${qs}`;

        expBox.style.display = 'block';
        expContent.innerHTML = quizData[curQ].exp || "<i>व्याख्या उपलब्ध नहीं है</i>";

        let userPick = userSelections[curQ];
        let correctPick = quizData[curQ].ans;

        quizData[curQ].options.forEach((val, i) => {
          let row = document.createElement('div');
          row.className = 'opt-row';
          if (i === correctPick) {
            row.classList.add('review-correct');
            row.innerHTML = `<span>✓ <b>(${letters[i]})</b> ${val} (Correct Answer)</span>`;
          } else if (i === userPick && userPick !== correctPick) {
            row.classList.add('review-wrong');
            row.innerHTML = `<span>✗ <b>(${letters[i]})</b> ${val} (Your Choice)</span>`;
          } else {
            row.innerHTML = `<span><b>(${letters[i]})</b> ${val}</span>`;
          }
          opts.appendChild(row);
        });
        syncReviewPalette();
      }
    }

    function pickOption(val) {
      if (isReviewMode) return;
      userSelections[curQ] = val;
      if (examStatuses[curQ] === 3 || examStatuses[curQ] === 4) examStatuses[curQ] = 4;
      else examStatuses[curQ] = 2;
      syncPaletteStyles();

      if (document.getElementById('autoNextSwitch').checked) {
        clearTimeout(autoNextTimeout);
        autoNextTimeout = setTimeout(() => { saveAndNext(); }, 650);
      }
    }

    function saveAndNext() {
      clearTimeout(autoNextTimeout);
      if (userSelections[curQ] !== undefined) {
        if (examStatuses[curQ] !== 4) examStatuses[curQ] = 2;
      } else {
        if (examStatuses[curQ] !== 3) examStatuses[curQ] = 1;
      }
      if (curQ < quizData.length - 1) loadQuestionIndex(curQ + 1);
      else syncPaletteStyles();
    }

    function markForReviewAndNext() {
      clearTimeout(autoNextTimeout);
      examStatuses[curQ] = (userSelections[curQ] !== undefined) ? 4 : 3;
      if (curQ < quizData.length - 1) loadQuestionIndex(curQ + 1);
      else syncPaletteStyles();
    }

    function clearResponse() {
      clearTimeout(autoNextTimeout);
      delete userSelections[curQ];
      document.querySelectorAll('input[name="opt_rad"]').forEach(r => r.checked = false);
      examStatuses[curQ] = (examStatuses[curQ] === 4) ? 3 : 1;
      syncPaletteStyles();
    }

    function jumpToQ(idx) {
      clearTimeout(autoNextTimeout);
      if (!isReviewMode) {
        if (userSelections[curQ] === undefined && examStatuses[curQ] !== 3) examStatuses[curQ] = 1;
      }
      loadQuestionIndex(idx);
    }

    function syncPaletteStyles() {
      for (let i = 0; i < quizData.length; i++) {
        let node = document.getElementById(`pnode-${i}`);
        node.className = 'p-node';
        if (i === curQ) node.classList.add('current');
        switch(examStatuses[i]) {
          case 0: node.classList.add('not-visited'); break;
          case 1: node.classList.add('not-answered'); break;
          case 2: node.classList.add('answered'); break;
          case 3: node.classList.add('review'); break;
          case 4: node.classList.add('ans-review'); break;
        }
      }
      refreshLegendCounts();
    }

    function refreshLegendCounts() {
      let counts = { 0: 0, 1: 0, 2: 0, 3: 0, 4: 0 };
      examStatuses.forEach(s => counts[s]++);
      document.getElementById('badgeNotVisit').innerText = counts[0];
      document.getElementById('badgeNotAns').innerText = counts[1];
      document.getElementById('badgeAns').innerText = counts[2];
      document.getElementById('badgeRev').innerText = counts[3];
      document.getElementById('badgeAnsRev').innerText = counts[4];
    }

    function runExamClock() {
      examTimerRef = setInterval(() => {
        if (testTimeRemaining > 0) {
          testTimeRemaining--;
          let m = Math.floor(testTimeRemaining / 60).toString().padStart(2, '0');
          let s = (testTimeRemaining % 60).toString().padStart(2, '0');
          document.getElementById('masterTimer').innerText = `00 : ${m} : ${s}`;
        } else {
          finalizeSubmission();
        }

        singleQTime++;
        let qm = Math.floor(singleQTime / 60).toString().padStart(2, '0');
        let qs = (singleQTime % 60).toString().padStart(2, '0');
        document.getElementById('qStopwatch').innerText = `${qm} : ${qs}`;
      }, 1000);
    }

    function finalizeSubmission() {
      clearInterval(examTimerRef);
      clearTimeout(autoNextTimeout);

      // Record time of the final question
      questionTimesSpent[curQ] = (questionTimesSpent[curQ] || 0) + singleQTime;

      let correct = 0, wrong = 0;
      let att = Object.keys(userSelections).length;
      let total = quizData.length;

      for (let idx in userSelections) {
        if (userSelections[idx] === quizData[idx].ans) correct++;
        else wrong++;
      }

      let skipped = total - att;
      let netScore = (correct * 1) - (wrong * 0.25);
      let acc = att > 0 ? ((correct / att) * 100).toFixed(1) : 0;

      document.getElementById('rTotal').innerText = total;
      document.getElementById('rAttempt').innerText = att;
      document.getElementById('rCorrect').innerText = correct;
      document.getElementById('rWrong').innerText = wrong;
      document.getElementById('rAcc').innerText = acc + "%";
      document.getElementById('rScore').innerText = netScore.toFixed(2);

      renderAnalyticsGraphs(correct, wrong, skipped, total, acc);

      goToStage(7);

      if (typeof confetti === 'function') {
        confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
        setTimeout(() => {
          confetti({ particleCount: 50, angle: 60, spread: 55, origin: { x: 0 } });
          confetti({ particleCount: 50, angle: 120, spread: 55, origin: { x: 1 } });
        }, 300);
      }
    }

    function renderAnalyticsGraphs(correct, wrong, skipped, total, acc) {
      document.getElementById('pieAccuracyLabel').innerText = acc + "%";
      document.getElementById('labelBarCorrect').innerText = `${correct} Qs (${((correct/total)*100).toFixed(0)}%)`;
      document.getElementById('labelBarWrong').innerText = `${wrong} Qs (${((wrong/total)*100).toFixed(0)}%)`;
      document.getElementById('labelBarSkipped').innerText = `${skipped} Qs (${((skipped/total)*100).toFixed(0)}%)`;

      setTimeout(() => {
        document.getElementById('barFillCorrect').style.width = `${(correct / total) * 100}%`;
        document.getElementById('barFillWrong').style.width = `${(wrong / total) * 100}%`;
        document.getElementById('barFillSkipped').style.width = `${(skipped / total) * 100}%`;
      }, 100);

      let correctDeg = (correct / total) * 360;
      let wrongDeg = correctDeg + ((wrong / total) * 360);
      document.getElementById('pieChartVisual').style.background = 
        `conic-gradient(#22c55e 0deg ${correctDeg}deg, #ef4444 ${correctDeg}deg ${wrongDeg}deg, #94a3b8 ${wrongDeg}deg 360deg)`;
    }

    function startExamReviewMode() {
      isReviewMode = true;
      document.getElementById('examTopTitle').innerText = "IBPS RRB - Review Mode";
      document.getElementById('autoToggleContainer').style.display = "none";
      document.getElementById('qTimerWrap').style.display = "inline";
      document.getElementById('examFooterNormal').style.display = "none";
      document.getElementById('examFooterReview').style.display = "flex";
      document.getElementById('legendTableWrap').style.display = "none";

      goToStage(6);
      loadQuestionIndex(0);
      syncReviewPalette();
    }

    function syncReviewPalette() {
      for (let i = 0; i < quizData.length; i++) {
        let node = document.getElementById(`pnode-${i}`);
        node.className = 'p-node';
        if (i === curQ) node.classList.add('current');

        let userChoice = userSelections[i];
        if (userChoice !== undefined) {
          if (userChoice === quizData[i].ans) {
            node.classList.add('review-state-correct');
          } else {
            node.classList.add('review-state-wrong');
          }
        } else {
          node.classList.add('review-state-skipped');
        }
      }
    }

    function navigateReview(direction) {
      let target = curQ + direction;
      if (target >= 0 && target < quizData.length) loadQuestionIndex(target);
    }

    window.onload = function() {
      initTheme();
      buildMathVault();
    };
  </script>
</body>
</html>
